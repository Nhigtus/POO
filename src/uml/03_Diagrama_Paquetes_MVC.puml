@startuml 03_Diagrama_Paquetes_MVC
!pragma layout smetana
' Diagrama de paquetes: arquitectura MVC del proyecto.
' GUI y vista son dos presentaciones distintas: Swing y consola.

title Sistema ERP Fincas de Cacao - Arquitectura MVC
skinparam packageStyle rectangle
skinparam nodesep 70
skinparam ranksep 90

package "modelo" as modelo {
  note "Producto\nProductoPerecedero\nPais\nUbicacion_Corporativa\nAlmacenes\nZona\nUsuario\nMovimiento_Logistico" as nM
}

package "controlador" as controlador {
  interface ICRUD
  note "Controlador_Productos\nControlador_Almacenes\nControlador_UbicacionCorporativa\nControlador_Zona\nControlador_Usuario\nControlador_movimiento\n\nTodos implementan ICRUD" as nC
}

package "vista (consola)" as vista {
  note "Principal\nVista_Productos\nVista_Almacenes\nVista_Ubicacion_Corporativa\nVista_Usuarios\nVista_Movimiento_Logistico" as nV
}

package "GUI (Swing)" as gui {
  note "Frm_Menu\nFrm_Login\nFrm_Productos\nFrm_Almacenes\nFrm_Ubicacion_Corporativa\nFrm_Movimientos\nFrm_Usuarios\nSesion" as nG
}

' Dependencias entre capas
vista ..> controlador : usa
gui ..> controlador : usa
controlador ..> modelo : usa

note bottom of gui
  Frm_Menu es la ventana principal
  (main.class del proyecto).
  Frm_Login aun no esta conectado
  al flujo; se usara en la Entrega 3.
end note

@enduml
